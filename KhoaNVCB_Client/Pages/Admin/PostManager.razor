@page "/admin/posts"
@using KhoaNVCB_Client.Models
@using KhoaNVCB_Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject PostService PostService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Quản lý Bài viết - Admin</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h2 class="fw-bold m-0 border-start border-danger border-4 ps-2" style="color: #1a237e;">QUẢN LÝ BÀI GIẢNG / BÀI VIẾT</h2>
        <a href="/admin/posts/create" class="btn btn-danger fw-bold shadow-sm">
            <i class="oi oi-plus me-1"></i> VIẾT BÀI MỚI
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th style="width: 100px;">Ảnh bìa</th>
                        <th>Tiêu đề bài viết</th>
                        <th>Chuyên mục</th>
                        <th>Ngày đăng</th>
                        <th class="text-end" style="width: 200px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (posts == null)
                    {
                        <tr><td colspan="5" class="text-center py-5"><div class="spinner-border text-danger"></div></td></tr>
                    }
                    else if (!posts.Any())
                    {
                        <tr><td colspan="5" class="text-center py-5 text-muted">Chưa có bài viết nào trong hệ thống.</td></tr>
                    }
                    else
                    {
                        foreach (var post in posts)
                        {
                            <tr>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(post.OriginalUrl) ? "https://via.placeholder.com/100" : post.OriginalUrl)"
                                         class="rounded" style="width: 80px; height: 50px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/100'" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 350px;">@post.Title</div>
                                    <div class="small text-muted text-truncate" style="max-width: 350px;">@post.Summary</div>
                                </td>
                                <td><span class="badge bg-secondary">@post.CategoryName</span></td>
                                <td>@(post.CreatedDate?.ToString("dd/MM/yyyy HH:mm"))</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => EditPost(post.PostId)">
                                        <i class="oi oi-pencil"></i> Sửa
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePost(post.PostId, post.Title)">
                                        <i class="oi oi-trash"></i> Xóa
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<PostDto>? posts;

    protected override async Task OnInitializedAsync()
    {
        await LoadPosts();
    }

    private async Task LoadPosts()
    {
        // Lấy danh sách toàn bộ bài viết từ API
        posts = await PostService.GetAllAsync();

        // Sắp xếp bài mới nhất lên đầu
        if (posts != null)
        {
            posts = posts.OrderByDescending(p => p.CreatedDate).ToList();
        }
    }

    private void EditPost(int id)
    {
        // Điều hướng sang trang Editor mà ta đã làm, kèm theo ID
        Nav.NavigateTo($"/admin/posts/edit/{id}");
    }

    private async Task DeletePost(int id, string title)
    {
        // Hiển thị hộp thoại xác nhận bằng JavaScript
        bool isConfirmed = await JS.InvokeAsync<bool>("confirm", $"Bạn có chắc chắn muốn xóa bài viết:\n'{title}'\nHành động này không thể hoàn tác!");

        if (isConfirmed)
        {
            var success = await PostService.DeleteAsync(id);
            if (success)
            {
                await LoadPosts(); // Tải lại bảng sau khi xóa thành công
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Lỗi: Không thể xóa bài viết này từ máy chủ.");
            }
        }
    }
}